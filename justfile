# What CI runs, locally. Run before pushing.
check:
    cd server && go vet ./...
    cd server && go test ./...
    cd server && golangci-lint-pinned run ./...
    cd server && go run golang.org/x/vuln/cmd/govulncheck@latest ./...
    go run github.com/zricethezav/gitleaks/v8@latest git --redact .
